generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  name              String               @default("")
  id                String               @id @default(uuid())
  username          String               @unique
  email             String               @unique
  activated         Boolean              @default(true)
  password          String
  role              userRole             @default(USER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  userImg           String               @default("")
  isDeleted         Boolean              @default(false)
  deletedAt         DateTime?
  schoolId          String?              @unique
  course            String?
  yearLevel         String?
  totalPoints       Int                  @default(0)
  loginStreak       Int                  @default(0)
  lastLoginDate     DateTime?
  rankSnapshot      Int?
  isFlagged         Boolean              @default(false)
  flagReason        String?
  flaggedAt         DateTime?
  ClaimAuditLog     ClaimAuditLog[]
  claim             Claim[]
  foundItem         FoundItem[]
  LostItem          LostItem[]
  Comment           Comment[]
  points            Points[]
  loginLogs         LoginLog[]
  userWarnings      UserWarning[]
  moderationAppeals ModerationAppeal[]
  chatMessages      ChatMessage[]
  pushSubscriptions PushSubscription[]
  chatReadStatuses  ChatReadStatus[]
  userAchievements  UserAchievement[]
  sightings         Sighting[]
  systemAuditLogs   SystemAuditLog[]
  bountyProgress    UserBountyProgress[]

  @@map("users")
}

model ItemCategory {
  id         String      @id @default(uuid())
  name       String
  icon       String?     @default("Tag")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  foundItems FoundItem[]
  LostItem   LostItem[]

  @@map("itemsCategories")
}

model FoundItem {
  id                 String              @id @default(uuid())
  userId             String?
  img                String              @default("")
  categoryId         String
  foundItemName      String
  description        String
  location           String
  date               DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  claimProcess       String              @default("")
  isClaimed          Boolean             @default(false)
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  reporterName       String              @default("")
  archivedAt         DateTime?
  isArchived         Boolean             @default(false)
  schoolEmail        String              @default("")
  urgencyLevel       UrgencyLevel        @default(NORMAL)
  urgencyScore       Int                 @default(0)
  urgencyReason      String?
  claim              Claim[]
  category           ItemCategory        @relation(fields: [categoryId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  matchNotifications MatchNotification[]

  @@map("foundItems")
}

model LostItem {
  id                 String              @id @default(uuid())
  userId             String?
  lostItemName       String
  categoryId         String
  img                String              @default("")
  description        String
  location           String
  date               DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isFound            Boolean             @default(false)
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  reporterName       String              @default("")
  schoolEmail        String              @default("")
  urgencyLevel       UrgencyLevel        @default(NORMAL)
  urgencyScore       Int                 @default(0)
  urgencyReason      String?
  category           ItemCategory        @relation(fields: [categoryId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  matchNotifications MatchNotification[]
  sightings          Sighting[]

  @@map("lostItems")
}

model Claim {
  id                     String          @id @default(uuid())
  userId                 String?
  foundItemId            String
  isDeleted              Boolean         @default(false)
  deletedAt              DateTime?
  status                 status          @default(PENDING)
  distinguishingFeatures String?
  lostDate               DateTime
  claimantName           String          @default("")
  contactNumber          String          @default("")
  schoolEmail            String          @default("")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  auditLogs              ClaimAuditLog[]
  foundItem              FoundItem       @relation(fields: [foundItemId], references: [id])
  user                   User?           @relation(fields: [userId], references: [id])
  chatRoom               ChatRoom?

  fraudScore             Int             @default(0)
  fraudReason            String?         @db.Text
  isHighRisk             Boolean         @default(false)

  @@map("claims")
}

model ClaimAuditLog {
  id              String   @id @default(uuid())
  claimId         String
  action          String
  fromStatus      String
  toStatus        String
  performedBy     String   @default("Admin")
  performedById   String?
  note            String   @default("")
  createdAt       DateTime @default(now())
  claim           Claim    @relation(fields: [claimId], references: [id])
  performedByUser User?    @relation(fields: [performedById], references: [id])

  @@map("claimAuditLogs")
}

model SystemAuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String?
  action        String
  oldData       String?
  newData       String?
  performedBy   String   @default("System")
  performedById String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@map("systemAuditLogs")
}

model BulletinPost {
  id           String        @id @default(uuid())
  itemName     String
  description  String
  location     String
  dateLost     DateTime
  imageUrl     String        @default("")
  reporterName String        @default("")
  contactHint  String        @default("")
  isResolved   Boolean       @default(false)
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tips         BulletinTip[]

  @@map("bulletinPosts")
}

model BulletinTip {
  id             String       @id @default(uuid())
  bulletinPostId String
  location       String       @default("")
  details        String
  createdAt      DateTime     @default(now())
  bulletinPost   BulletinPost @relation(fields: [bulletinPostId], references: [id])

  @@map("bulletinTips")
}

model MatchNotification {
  id          String    @id @default(uuid())
  lostItemId  String
  foundItemId String
  sentAt      DateTime  @default(now())
  foundItem   FoundItem @relation(fields: [foundItemId], references: [id])
  lostItem    LostItem  @relation(fields: [lostItemId], references: [id])

  @@unique([lostItemId, foundItemId])
  @@map("matchNotifications")
}

model Comment {
  id              String             @id @default(uuid())
  itemId          String
  itemType        ItemType
  userId          String?
  content         String
  isAnonymous     Boolean            @default(false)
  helpfulCount    Int                @default(0)
  status          CommentStatus      @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  location        String?
  rejectionReason String?
  parentCommentId String?
  parent          Comment?           @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]          @relation("CommentReplies")
  user            User?              @relation(fields: [userId], references: [id])
  contentReports  ContentReport[]
  appeals         ModerationAppeal[]

  @@map("comments")
}

model Points {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("points")
}

model Announcement {
  id                String             @id @default(uuid())
  title             String
  message           String
  type              AnnouncementType   @default(INFO)
  target            AnnouncementTarget @default(ALL)
  sentByName        String             @default("Admin")
  sentById          String?
  sendEmail         Boolean            @default(false)
  emailSent         Boolean            @default(false)
  emailCount        Int                @default(0)
  publishAt         DateTime           @default(now())
  targetGroupYear   String?
  targetGroupCourse String?
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("announcements")
}

model SupportTicket {
  id          String         @id @default(uuid())
  subject     String
  message     String
  senderName  String         @default("")
  senderEmail String         @default("")
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  adminReply  String         @default("")
  repliedAt   DateTime?
  repliedBy   String         @default("")
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("supportTickets")
}

model Feedback {
  id          String           @id @default(uuid())
  senderName  String           @default("")
  senderEmail String           @default("")
  category    FeedbackCategory @default(GENERAL)
  message     String
  rating      Int?
  status      FeedbackStatus   @default(UNREAD)
  adminNote   String           @default("")
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("feedbacks")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  username  String   @default("")
  email     String   @default("")
  ipAddress String   @default("")
  userAgent String   @default("")
  success   Boolean  @default(false)
  reason    String   @default("")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("loginLogs")
}

// ── Moderation models ─────────────────────────────────────────────────────────

model ContentReport {
  id         String       @id @default(uuid())
  commentId  String
  reason     ReportReason @default(OTHER)
  details    String       @default("")
  reportedBy String       @default("Anonymous")
  status     ReportStatus @default(PENDING)
  resolvedBy String       @default("")
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  comment    Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("contentReports")
}

model UserWarning {
  id        String          @id @default(uuid())
  userId    String
  reason    String
  severity  WarningSeverity @default(LOW)
  issuedBy  String          @default("Admin")
  note      String          @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userWarnings")
}

model ModerationAppeal {
  id         String       @id @default(uuid())
  commentId  String
  userId     String?
  reason     String
  status     AppealStatus @default(PENDING)
  adminNote  String       @default("")
  resolvedBy String       @default("")
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  comment    Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("moderationAppeals")
}

model ChatRoom {
  id           String           @id @default(uuid())
  claimId      String?          @unique
  foundItemId  String?
  participants String[] // Array of user IDs
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     ChatMessage[]
  claim        Claim?           @relation(fields: [claimId], references: [id])
  readStatuses ChatReadStatus[]

  @@map("chatRooms")
}

model ChatMessage {
  id         String   @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)
  reactions  Json?    @default("[]")
  replyToId  String?
  replyTo    ChatMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChatMessage[] @relation("MessageReplies")
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])

  @@map("chatMessages")
}

model ChatReadStatus {
  id         String   @id @default(uuid())
  chatRoomId String
  userId     String
  lastReadAt DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@map("chatReadStatuses")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pushSubscriptions")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum status {
  PENDING
  APPROVED
  REJECTED
}

enum userRole {
  ADMIN
  USER
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ItemType {
  LOST
  FOUND
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  URGENT
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  ADMINS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackCategory {
  GENERAL
  BUG
  FEATURE
  COMPLAINT
  COMPLIMENT
}

enum FeedbackStatus {
  UNREAD
  READ
  RESOLVED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

model Achievement {
  id          String          @id @default(cuid())
  key         String          @unique // e.g. "FIRST_FOUND_ITEM"
  name        String // e.g. "First Responder"
  description String
  icon        String // emoji or icon name
  tier        AchievementTier
  category    String
  xp          Int             @default(0) // bonus XP on unlock
  secret      Boolean         @default(false)
  parentKey   String?         // For achievement chains (e.g., Bronze → Silver → Gold)
  createdAt   DateTime        @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  seen          Boolean  @default(false) // false = show popup
  isPinned      Boolean  @default(false) // showcase

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("userAchievements")
}

model Bounty {
  id           String               @id @default(uuid())
  title        String
  description  String
  targetCount  Int
  actionType   String
  xpReward     Int
  icon         String               @default("🎯")
  isActive     Boolean              @default(true)
  startDate    DateTime             @default(now())
  endDate      DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userProgress UserBountyProgress[]

  @@map("bounties")
}

model UserBountyProgress {
  id           String    @id @default(uuid())
  userId       String
  bountyId     String
  currentCount Int       @default(0)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bounty       Bounty    @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  @@unique([userId, bountyId])
  @@map("userBountyProgress")
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  LEGEND
}

enum UrgencyLevel {
  NORMAL
  HIGH
  CRITICAL
}

model Sighting {
  id              String   @id @default(uuid())
  lostItemId      String
  userId          String?
  reporterName    String   @default("Anonymous")
  img             String   @default("")
  location        String
  coordinates     String   @default("") // "lat,lng" format
  details         String   @default("")
  verifiedUserIds String[] @default([]) // Tracks user IDs who verified it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lostItem LostItem @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("sightings")
}

model VirtueSpotlight {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  students    String[] // array of recognized student names
  isActive    Boolean  @default(true)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("virtue_spotlights")
}

model XPBoostEvent {
  id          String   @id @default(uuid())
  name        String
  multiplier  Float    @default(2.0)
  startDate   DateTime
  endDate     DateTime
  createdBy   String   @default("Admin")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("xpBoostEvents")
}
